{
  "name": "@local/dsh-client-ui-office",
  "version": "0.1.0",
  "private": true,
  "description": "Local Word, Excel, and PowerPoint editing in the Omchor file panel.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "setup": "node setup.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests/editor.browser.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "MIT"
}
